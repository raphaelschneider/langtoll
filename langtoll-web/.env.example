# ── LangToll backend config ───────────────────────────────────────────────
# OpenAI (topic-pack generation)
OPENAI_API_KEY=
LANGTOLL_TOPIC_MODEL=gpt-4o-mini
# Global spend caps (0 = off). Backstop against runaway cost.
OPENAI_DAILY_USD_CAP=0
OPENAI_MONTHLY_USD_CAP=0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=langtoll

# App Attest (anonymous device auth). Inert until ATTEST_ENFORCE=1 + secret/team set.
APPLE_TEAM_ID=QSAPKESRUG
APP_BUNDLE_ID=com.langtoll.app
ATTEST_HMAC_SECRET=
ATTEST_ALLOW_DEV=1
ATTEST_ENFORCE=0

# Entitlement (server-verified Plus). Inert until ENTITLEMENT_ENFORCE=1 + RC secret.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=plus
ENTITLEMENT_ENFORCE=0
FREE_GRACE_DAYS=0

# Admin
ADMIN_PASSWORD=

# DeviceCheck (one-honeymoon-per-device). Optional.
DEVICECHECK_KEY_ID=
DEVICECHECK_TEAM_ID=QSAPKESRUG
DEVICECHECK_PRIVATE_KEY=
