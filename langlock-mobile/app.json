{
  "expo": {
    "name": "LangPass",
    "slug": "langpass",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "langpass",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.langpass.app",
      "appleTeamId": "QSAPKESRUG"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17171C"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.langpass.app",
          "appleTeamId": "QSAPKESRUG"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbceb583-0c38-48e8-a27f-89748f7bdec8"
      }
    },
    "owner": "retardo"
  }
}
