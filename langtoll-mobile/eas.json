{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.langpass.app",
        "EXPO_PUBLIC_DEV_TOOLS": "1"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-dev.langpass.app",
        "EXPO_PUBLIC_DEV_TOOLS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.langpass.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "QSAPKESRUG",
        "appleId": "APPLE_ID_EMAIL_HERE",
        "ascAppId": "ASC_APP_ID_HERE"
      }
    }
  }
}
