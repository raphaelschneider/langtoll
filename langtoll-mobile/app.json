{
  "expo": {
    "name": "LangToll",
    "slug": "langtoll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "langtoll",
      "device-activity"
    ],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.langtoll.app",
      "appleTeamId": "QSAPKESRUG",
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "buildNumber": "1"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F161B"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.langtoll.app",
          "appleTeamId": "QSAPKESRUG"
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbceb583-0c38-48e8-a27f-89748f7bdec8"
      }
    },
    "owner": "retardo"
  }
}